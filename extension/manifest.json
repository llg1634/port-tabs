{
  "manifest_version": 3,
  "name": "Port Tabs",
  "version": "0.3.4",
  "description": "Localhost browser control port for the installed Chrome profile.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "scripting",
    "debugger",
    "downloads",
    "history",
    "bookmarks",
    "storage",
    "cookies",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Port Tabs"
  }
}

